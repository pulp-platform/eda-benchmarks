--cc
--exe
--build
--assert
--timescale
1ns/1ps
-CFLAGS
-DTOPLEVEL_NAME=ibex_riscv_compliance
-LDFLAGS
-pthread -lutil -lelf
-GPMPEnable=1
-GPMPNumRegions=16
-GMHPMCounterNum=10
-GMHPMCounterWidth=64
-GRV32M=3
-GRV32B=3
-GRV32ZC=3
-GBranchTargetALU=1
-GWritebackStage=1
-GICache=1
-GICacheECC=1
-GBranchPredictor=1
-GDbgTriggerEn=1
-GDbgHwBreakNum=4
-GSecureIbex=1
-GLockstepOffset=1
-GICacheScramble=0
-GICacheTweakInfection=1

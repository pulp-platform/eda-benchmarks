+
+    function bit exclude_reference_result(fpu_req_t req,
+                                          logic [CVA6Cfg.FLen-1:0] result,
+                                          fpnew_pkg::status_t flags);
+      fpnew_pkg::fp_format_e fmt;
+      int unsigned mantissa_bits, exponent_bits;
+      logic [CVA6Cfg.FLen-1:0] exponent, fraction, exponent_mask, boxing_mask;
+      if (req.data.operation == FCVT_I2F) return flags.OF;
+      fmt = fpnew_pkg::fp_format_e'(req.data.operation == FCVT_F2F
+                                    ? req.data.imm[2:0] : {1'b0, req.fmt});
+      mantissa_bits = fpnew_pkg::man_bits(fmt);
+      exponent_bits = fpnew_pkg::exp_bits(fmt);
+      boxing_mask = '1;
+      boxing_mask = boxing_mask << fpnew_pkg::fp_width(fmt);
+      if (req.data.operation inside {FDIV, FSQRT})
+        return ((req.data.operand_a & boxing_mask) != boxing_mask)
+            || (req.data.operation == FDIV
+                && (req.data.operand_b & boxing_mask) != boxing_mask);
+      exponent_mask = (64'b1 << exponent_bits) - 1;
+      if (req.data.operation == FCVT_F2F) begin
+        exponent = (req.data.operand_a >> mantissa_bits) & exponent_mask;
+        fraction = req.data.operand_a & ((64'b1 << mantissa_bits) - 1);
+        return (req.data.operand_a & boxing_mask) == boxing_mask
+            && exponent == exponent_mask && fraction == 0;
+      end
+      if (req.data.operation inside {FADD, FSUB, FMUL, FMADD, FMSUB, FNMADD, FNMSUB})
+        return flags.UF && flags.NX
+            && (result & ((64'b1 << (mantissa_bits + exponent_bits)) - 1))
+               == (64'b1 << mantissa_bits);
+      return 0;
+    endfunction
 

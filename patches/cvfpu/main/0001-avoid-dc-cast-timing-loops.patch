+
+  assign denorm_shamt_fp        = SUPER_MAN_BITS - fpnew_pkg::man_bits(dst_fmt_q2);
+  assign denorm_shamt_int       = unsigned'(MAX_INT_WIDTH - 1 - input_exp_q);
+  assign denorm_shamt_fp_denorm = unsigned'(denorm_shamt_fp + 1 - destination_exp_q);
+  assign denorm_shamt_fp_sticky = SUPER_MAN_BITS + 2;
 
